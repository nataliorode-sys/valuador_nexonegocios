# Base de datos (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/nexodirecto?schema=public"

# Auth
AUTH_SECRET="cambiar-por-un-secreto-largo"

# Mercado Pago (Checkout Pro). Sin MP_ACCESS_TOKEN, el pago queda en modo simulado.
# Sacar de https://www.mercadopago.com.ar/developers → tu app → Credenciales.
# Empezar con las de PRUEBA (TEST-...). Access Token = secreto del servidor.
MP_ACCESS_TOKEN=""
MP_PUBLIC_KEY=""
# URL pública de la app (para back_urls y webhook de Mercado Pago).
# En dev podés dejarla vacía (usa el host de la request).
APP_BASE_URL=""

# Almacenamiento de fotos en R2/S3. Si estas 4 están seteadas, se usa R2/S3;
# si no, se usa disco local (UPLOAD_DIR). R2: https://<accountid>.r2.cloudflarestorage.com
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="auto"          # R2 usa "auto"; en AWS S3 poné la región del bucket
# Opcional: dominio público del bucket (bucket público o custom domain). Si se setea,
# las fotos se sirven directo desde ahí; si no, se sirven vía /api/media.
S3_PUBLIC_URL=""

# Email transaccional
RESEND_API_KEY=""
EMAIL_FROM="NexoDirecto <no-reply@tudominio.com>"
CRON_SECRET=""

# Motor
TC_REF_DEFAULT="1200"

# Subida de fotos: directorio local (default web/uploads). En produccion usar S3.
UPLOAD_DIR=""
