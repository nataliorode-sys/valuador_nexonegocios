# Base de datos (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/nexodirecto?schema=public"

# Auth
AUTH_SECRET="cambiar-por-un-secreto-largo"

# Mercado Pago (Checkout Pro). Sin MP_ACCESS_TOKEN, el pago queda en modo simulado.
# Sacar de https://www.mercadopago.com.ar/developers → tu app → Credenciales.
# Empezar con las de PRUEBA (TEST-...). Access Token = secreto del servidor.
MP_ACCESS_TOKEN=""
MP_PUBLIC_KEY=""
# URL pública de la app (para back_urls y webhook de Mercado Pago).
# En dev podés dejarla vacía (usa el host de la request).
APP_BASE_URL=""

# Almacenamiento S3 (fotos, PDFs, flyers)
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# Email transaccional
RESEND_API_KEY=""

# Motor
TC_REF_DEFAULT="1200"

# Subida de fotos: directorio local (default web/uploads). En produccion usar S3.
UPLOAD_DIR=""
